# CraftLaunch — Frontend environment variables
# Copy to .env.local for local development. Never commit the real .env.local.
#
# Only NEXT_PUBLIC_* variables are exposed to the browser. Never put a
# secret key, storage credential, or payment secret behind NEXT_PUBLIC_ —
# those belong on the Django backend only.

# ---- Active in Part 1 ----------------------------------------------------

# Base URL of the Django API this app talks to.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical URL of this frontend deployment (used in metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Reserved for later parts (not read by any code yet) -----------------

# Razorpay publishable key, used by the client-side Checkout widget.
# The Razorpay secret key is backend-only and must never appear here.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Set only if a later part adds unsigned client-side uploads. File
# uploads are expected to go through the Django backend by default so
# storage credentials never reach the browser.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
