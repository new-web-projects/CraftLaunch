# CraftLaunch — Backend environment variables
# Copy to .env for local development (config/settings/base.py loads it
# automatically). Never commit the real .env — it's already gitignored.
# In production, set these through your platform's secret manager
# instead of shipping a file.

# ---- Active in Part 1 -----------------------------------------------------

# Any long, random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Development falls back to an insecure built-in value if this is unset;
# production refuses to start without it.
DJANGO_SECRET_KEY=

# Neon Postgres connection string, e.g.:
#   postgres://user:password@ep-xxxx.neon.tech/craftlaunch?sslmode=require
# For local dev, branch a "dev" database off the same Neon project
# rather than pointing at a different database engine.
DATABASE_URL=

# Comma-separated. Only read in production (development hardcodes
# localhost/127.0.0.1).
DJANGO_ALLOWED_HOSTS=api.craftlaunch.example

# Comma-separated origins allowed to call this API from a browser.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Optional, have safe defaults -----------------------------------------

# DJANGO_LOG_SQL=False
# DB_CONN_MAX_AGE=0
# DB_DISABLE_SERVER_SIDE_CURSORS=True
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_PRELOAD=False

# ---- Reserved for later parts (not read by any code yet) -------------------

# Admin-switchable storage backend. Values will be "S3" or "CLOUDINARY".
# STORAGE_PROVIDER=

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# JWT access/refresh token lifetimes, once djangorestframework-simplejwt
# is introduced in the Authentication part.
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
