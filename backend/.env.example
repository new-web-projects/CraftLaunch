# CraftLaunch — Backend environment variables
# Copy to .env for local development (config/settings/base.py loads it
# automatically). Never commit the real .env — it's already gitignored.
# In production, set these through your platform's secret manager
# instead of shipping a file.

# ---- Active since Part 1 ---------------------------------------------------

# Any long, random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Development falls back to an insecure built-in value if this is unset;
# production refuses to start without it. Also used to sign JWTs unless
# JWT_SIGNING_KEY is set separately (see below).
DJANGO_SECRET_KEY=

# Neon Postgres connection string, e.g.:
#   postgres://user:password@ep-xxxx.neon.tech/craftlaunch?sslmode=require
# For local dev, branch a "dev" database off the same Neon project
# rather than pointing at a different database engine.
DATABASE_URL=

# Comma-separated. Only read in production (development hardcodes
# localhost/127.0.0.1).
DJANGO_ALLOWED_HOSTS=api.craftlaunch.example

# Comma-separated origins allowed to call this API from a browser.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Active since Part 2 (Authentication) ----------------------------------

# Shared cache for rate limiting/throttling — required in production
# (multiple gunicorn workers need one shared counter, not one each).
# Point this at a managed Redis (Upstash, Redis Cloud, ElastiCache, ...)
# in production; optional in dev (falls back to an in-process cache,
# fine for `runserver`, but set this if running dev via docker-compose
# and you want rate-limit behavior to match production).
#   redis://:password@host:6379/0
REDIS_URL=

# Used to build the links inside verification/reset emails, e.g.
# "${FRONTEND_URL}/verify-email?uid=...&token=...".
FRONTEND_URL=http://localhost:3000

# Interim value shown in email subject lines until an admin sets one
# via the Settings API (apps/configuration/models.py's SiteConfiguration,
# Part 4) — 0002_seed_from_env seeds the database row from this on
# first migration, then apps/accounts/emails.py reads the database
# row from then on. Kept as the hardcoded fallback for that read (see
# emails.py's _site_name()) and for anything that runs before the
# database is reachable.
SITE_NAME=CraftLaunch

DEFAULT_FROM_EMAIL=no-reply@craftlaunch.example

# Console backend in dev prints these instead of sending — leave blank
# locally. Required in production (any standard SMTP provider works:
# SendGrid, Postmark, Mailgun, AWS SES's SMTP endpoint, ...).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Access tokens are short-lived on purpose — see docs/ARCHITECTURE.md
# for why a blacklisted refresh token doesn't retroactively invalidate
# an already-issued access token.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
JWT_REMEMBER_ME_LIFETIME_DAYS=30
# Only set this if you want JWTs signed with a different key than
# DJANGO_SECRET_KEY (uncommon — most projects don't need this).
# JWT_SIGNING_KEY=

# ---- Active since Part 4 ---------------------------------------------------

# Encrypts apps.configuration's secret fields (SMTP password, storage/
# payment API secrets) at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Optional (see apps/configuration/fields.py for the dev-only fallback),
# but production should set this explicitly rather than rely on it.
# CONFIGURATION_ENCRYPTION_KEY=

# ---- Optional, have safe defaults -----------------------------------------

# DJANGO_LOG_SQL=False
# DB_CONN_MAX_AGE=0
# DB_DISABLE_SERVER_SIDE_CURSORS=True
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_PRELOAD=False

# ---- Active since Part 3, seed the Part 4 configuration singletons --------
# (config/settings/base.py reads these directly; apps/configuration's
# 0002_seed_from_env migration copies whatever was set here into the
# StorageConfiguration/EmailConfiguration rows the first time it runs,
# so upgrading doesn't blank out credentials already working. After
# that first migration, the database row is what's actually read
# (apps/configuration/services.py) — changing these env vars after the
# fact has no effect; use the admin settings API instead.)

# STORAGE_PROVIDER=

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Part 6: Razorpay (bootstrap only) --------------------------------------
# Optional — seeds PaymentConfiguration's first row on `migrate`
# (apps/configuration/migrations/0003_seed_razorpay_from_env.py) so
# local dev doesn't require a trip through the admin settings UI
# first. Seeded with is_enabled=False regardless — an admin turns
# payments on explicitly from Settings → Payment Settings once
# test-mode checkout has actually been verified end to end. After
# that first migrate, these three env vars are no longer read by
# anything; every real Razorpay API call reads the (admin-editable,
# encrypted-at-rest) database row instead, so switching test/live
# mode later never needs a redeploy.
# Get test-mode keys from the Razorpay Dashboard → Settings → API Keys
# (Test Mode toggle on). Webhook secret comes from Dashboard →
# Settings → Webhooks when you register this app's webhook URL.

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
